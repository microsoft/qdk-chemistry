@PACKAGE_INIT@

get_filename_component(QDK_CMAKE_DIR "${CMAKE_CURRENT_LIST_FILE}" PATH)
list(PREPEND CMAKE_MODULE_PATH ${QDK_CMAKE_DIR})

set(QDK_CHEMISTRY_ENABLE_GPU "@QDK_CHEMISTRY_ENABLE_GPU@" CACHE BOOL "Enable QDK GPU Bindings" FORCE)
set(QDK_CHEMISTRY_ENABLE_HGP "@QDK_CHEMISTRY_ENABLE_HGP@" CACHE BOOL "Enable HGP Bindings" FORCE)
set(QDK_CHEMISTRY_ENABLE_LIBINTX "@QDK_CHEMISTRY_ENABLE_LIBINTX@" CACHE BOOL "Enable LIBINTX Bindings" FORCE)
set(QDK_CHEMISTRY_ENABLE_MPI "@QDK_CHEMISTRY_ENABLE_MPI@" CACHE BOOL "Enable MPI Bindings" FORCE)
set(QDK_ENABLE_OPENMP "@QDK_ENABLE_OPENMP@" CACHE BOOL "Enable OpenMP Bindings" FORCE)
set(QDK_CHEMISTRY_ENABLE_PCM "@QDK_CHEMISTRY_ENABLE_PCM@" CACHE BOOL "Enable PCM Bindings" FORCE)
set(QDK_CHEMISTRY_ENABLE_DFTD3 "@QDK_CHEMISTRY_ENABLE_DFTD3@" CACHE BOOL "Enable DFTD3 Bindings" FORCE)

# Always Required Dependencies
include(CMakeFindDependencyMacro)

# When the SCF BLAS thread-control API was bound at link time, the installed
# archive references vendor-specific symbols (e.g. openblas_set_num_threads)
# while the exported dependency is the vendor-agnostic BLAS::BLAS. Steer the
# search below to the same provider, or a machine with several BLAS
# installations may pick a different one and fail to link.
set(QDK_CHEMISTRY_REQUIRED_BLAS_VENDOR "@QDK_CHEMISTRY_REQUIRED_BLAS_VENDOR@")
set(QDK_CHEMISTRY_BLAS_THREAD_SYMBOL "@QDK_CHEMISTRY_BLAS_THREAD_SYMBOL@")
if(QDK_CHEMISTRY_REQUIRED_BLAS_VENDOR AND NOT BLAS_PREFERENCE_LIST)
  set(BLAS_PREFERENCE_LIST "${QDK_CHEMISTRY_REQUIRED_BLAS_VENDOR}")
endif()

# Make sure C / CXX / CUDA are enabled (former for BLAS discovery)
enable_language(C)
enable_language(CXX)
if(QDK_CHEMISTRY_ENABLE_GPU)
  enable_language(CUDA)
endif()

if(QDK_CHEMISTRY_ENABLE_GPU)
  find_dependency(CUDAToolkit REQUIRED)
endif()
if(QDK_CHEMISTRY_ENABLE_HGP)
  find_dependency(HGP REQUIRED)
endif()
if(QDK_CHEMISTRY_ENABLE_LIBINTX)
  find_dependency(libintx REQUIRED)
endif()
if(QDK_CHEMISTRY_ENABLE_MPI)
  find_dependency(MPI REQUIRED)
endif()
if (QDK_ENABLE_OPENMP)
  find_dependency(OpenMP REQUIRED)
endif()

find_dependency(macis REQUIRED)
find_dependency(Eigen3 REQUIRED)
find_dependency(HDF5 REQUIRED COMPONENTS CXX)
find_dependency(nlohmann_json REQUIRED)
find_dependency(Libint2 REQUIRED)
find_dependency(ecpint REQUIRED)
find_dependency(LAPACK REQUIRED)
find_dependency(gauxc REQUIRED)
find_dependency(Threads REQUIRED)

if(QDK_CHEMISTRY_ENABLE_DFTD3)
  find_dependency(s-dftd3 REQUIRED)
endif()

if(QDK_CHEMISTRY_ENABLE_PCM)
  find_dependency(PCMSolver REQUIRED)
  find_dependency(ddX REQUIRED)
endif()

list(REMOVE_AT CMAKE_MODULE_PATH 0)

# Check the bound symbol rather than comparing vendor names: BLAS_VENDOR is only
# set when the linalg FindBLAS module performs the search, so it is empty
# whenever another module found BLAS first. Failing here beats an unresolved
# symbol at link time.
if(QDK_CHEMISTRY_BLAS_THREAD_SYMBOL)
  include(CheckFunctionExists)

  # A function, not a macro, so CMAKE_REQUIRED_* stays local.
  function(_qdk_check_blas_thread_symbol symbol out_var)
    if(TARGET BLAS::BLAS)
      set(CMAKE_REQUIRED_LIBRARIES BLAS::BLAS)
    else()
      set(CMAKE_REQUIRED_LIBRARIES ${BLAS_LIBRARIES})
    endif()
    set(CMAKE_REQUIRED_INCLUDES ${BLAS_INCLUDE_DIRS})
    set(CMAKE_REQUIRED_QUIET TRUE)
    check_function_exists(${symbol} QDK_CHEMISTRY_CONSUMER_HAS_${symbol})
    set(${out_var} "${QDK_CHEMISTRY_CONSUMER_HAS_${symbol}}" PARENT_SCOPE)
  endfunction()

  _qdk_check_blas_thread_symbol(
    "${QDK_CHEMISTRY_BLAS_THREAD_SYMBOL}" _qdk_blas_thread_symbol_found)

  if(NOT _qdk_blas_thread_symbol_found)
    message(FATAL_ERROR
      "qdk::chemistry was built against BLAS vendor "
      "'${QDK_CHEMISTRY_REQUIRED_BLAS_VENDOR}' and calls "
      "'${QDK_CHEMISTRY_BLAS_THREAD_SYMBOL}', which the BLAS resolved here "
      "(${BLAS_LIBRARIES}) does not provide; linking would fail with an "
      "unresolved symbol. Point this project at the same BLAS (e.g. "
      "-DBLAS_LIBRARIES=..., -DBLA_VENDOR=... or "
      "-DBLAS_PREFERENCE_LIST=${QDK_CHEMISTRY_REQUIRED_BLAS_VENDOR}), or "
      "rebuild qdk-chemistry with -DQDK_CHEMISTRY_BLAS_THREAD_API=NONE to make "
      "the library independent of a particular BLAS provider.")
  endif()
endif()

if(NOT TARGET qdk::chemistry)
  include("${CMAKE_CURRENT_LIST_DIR}/chemistryTargets.cmake")
endif()

check_required_components(chemistry)
