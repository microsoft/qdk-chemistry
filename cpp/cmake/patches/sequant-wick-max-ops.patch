+  /// Bounds the number of uncontracted operators in the terms emitted by the
+  /// next call to compute(); only matters if full_contractions(false), and is
+  /// not supported under a Vacuum::MultiProduct vacuum. Partial contractions
+  /// above the bound are still contracted further, so this equals dropping
+  /// those terms from the result, without ever forming them.
+  /// @param n the largest number of uncontracted operators of a term;
+  /// std::nullopt (default) means no bound
+  /// @return reference to @c *this , for daisy-chaining
+  WickTheorem &max_ops(std::optional<std::size_t> n) {
+    max_ops_ = n;
+    return *this;
+  }
