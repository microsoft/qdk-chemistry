#pragma once
#include <filesystem>

#cmakedefine QDK_CHEMISTRY_ENABLE_MPI
#cmakedefine QDK_CHEMISTRY_ENABLE_GPU
#cmakedefine QDK_CHEMISTRY_ENABLE_HGP
#cmakedefine QDK_CHEMISTRY_ENABLE_RYS
#cmakedefine QDK_CHEMISTRY_ENABLE_LIBINTX
#cmakedefine QDK_CHEMISTRY_ENABLE_QMMM
#cmakedefine QDK_CHEMISTRY_ENABLE_PCM
#cmakedefine QDK_CHEMISTRY_ENABLE_DFTD3

// BLAS backend from the configure-time search; empty if none was reported.
#define QDK_CHEMISTRY_BLAS_VENDOR "@QDK_CHEMISTRY_BLAS_VENDOR@"

// Candidate thread-control APIs, in probe order, from the table in
// src/CMakeLists.txt. Columns: token, enumerator, label, setter, getter, type.
#define QDK_CHEMISTRY_BLAS_BACKEND_TABLE(X) \
@QDK_CHEMISTRY_BLAS_BACKEND_TABLE@

// The row bound at link time; undefined when none, making the guard a no-op.
#cmakedefine QDK_CHEMISTRY_BLAS_LINKED_VENDOR @QDK_CHEMISTRY_BLAS_LINKED_VENDOR@
#cmakedefine QDK_CHEMISTRY_BLAS_LINKED_SET_FN @QDK_CHEMISTRY_BLAS_LINKED_SET_FN@
#cmakedefine QDK_CHEMISTRY_BLAS_LINKED_GET_FN @QDK_CHEMISTRY_BLAS_LINKED_GET_FN@
#cmakedefine QDK_CHEMISTRY_BLAS_LINKED_TYPE @QDK_CHEMISTRY_BLAS_LINKED_TYPE@

namespace qdk::chemistry::scf {

class QDKChemistryConfig {
 private:
  QDKChemistryConfig() = default;  // Singleton Pattern for the config
  static std::filesystem::path resources_dir_;

 public:
  static std::filesystem::path get_resources_dir();
  static void set_resources_dir(const std::filesystem::path& path);
};

}  // namespace qdk::chemistry::scf
