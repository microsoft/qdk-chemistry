  evaluate_L1_vvop(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  evaluate_L1_vvov(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  evaluate_L1_vvpp(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  evaluate_L1_vvvp(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  evaluate_L1_vvvv(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  auto one_a = workspace.assemble_one_body(false);
  auto one_b = workspace.assemble_one_body(true);
  auto two_aa = antisymmetrize_L1(workspace.assemble_two_body(0));
  auto two_ab = workspace.assemble_two_body(1);
  auto two_bb = antisymmetrize_L1(workspace.assemble_two_body(2));
  const double gamma0 = workspace.reference_energy() + workspace.get_scalar("E0");
  auto occupied_a = workspace.active_occupied_projector(false);
  auto occupied_b = workspace.active_occupied_projector(true);
  auto chi_a = one_a;
  auto chi_b = one_b;
  btas::contract(-1.0, two_aa, {'p', 'm', 'q', 'n'}, occupied_a, {'m', 'n'}, 1.0, chi_a, {'p', 'q'});
  btas::contract(-1.0, two_ab, {'p', 'm', 'q', 'n'}, occupied_b, {'m', 'n'}, 1.0, chi_a, {'p', 'q'});
  btas::contract(-1.0, two_bb, {'p', 'm', 'q', 'n'}, occupied_b, {'m', 'n'}, 1.0, chi_b, {'p', 'q'});
  btas::contract(-1.0, two_ab, {'m', 'p', 'n', 'q'}, occupied_a, {'m', 'n'}, 1.0, chi_b, {'p', 'q'});
  double chi0 = gamma0 - btas::dot(chi_a, occupied_a) - btas::dot(chi_b, occupied_b);
  btas::Tensor<double> occupied_pair;
  btas::contract(1.0, two_aa, {'m', 'n', 'p', 'q'}, occupied_a, {'m', 'p'}, 0.0, occupied_pair, {'n', 'q'});
  chi0 -= 0.5 * btas::dot(occupied_pair, occupied_a);
  btas::contract(1.0, two_bb, {'m', 'n', 'p', 'q'}, occupied_b, {'m', 'p'}, 0.0, occupied_pair, {'n', 'q'});
  chi0 -= 0.5 * btas::dot(occupied_pair, occupied_b);
  btas::contract(1.0, two_ab, {'m', 'n', 'p', 'q'}, occupied_a, {'m', 'p'}, 0.0, occupied_pair, {'n', 'q'});
  chi0 -= btas::dot(occupied_pair, occupied_b);
  workspace.put_final(std::move(chi_a), std::move(chi_b), to_chemist_L1(two_aa, 0.5), to_chemist_L1(two_ab, 1.0), to_chemist_L1(two_bb, 0.5), chi0);
}

void evaluate_ducc_L1(
    const btas::Tensor<double> &h_a, const btas::Tensor<double> &h_b,
    const btas::Tensor<double> &v_aa, const btas::Tensor<double> &v_ab,
    const btas::Tensor<double> &v_bb, const btas::Tensor<double> &t1_a,
    const btas::Tensor<double> &t1_b, const btas::Tensor<double> &t2_ab,
    const btas::Tensor<double> &t2_aa, const btas::Tensor<double> &t2_bb,
    std::span<const std::uint32_t> active_a,
    std::span<const std::uint32_t> active_b, std::size_t nocc_a,
    std::size_t nocc_b, bool restricted,
    double core_energy, btas::Tensor<double> &output_one_a,
    btas::Tensor<double> &output_one_b,
    btas::Tensor<double> &output_two_aa,
    btas::Tensor<double> &output_two_ab,
    btas::Tensor<double> &output_two_bb, double &output_scalar) {
  DuccGeneratedWorkspace workspace(
      h_a, h_b, v_aa, v_ab, v_bb, t1_a, t1_b, t2_ab, t2_aa, t2_bb,
      active_a, active_b, nocc_a, nocc_b, restricted,
      core_energy, output_one_a, output_one_b,
      output_two_aa, output_two_ab, output_two_bb, output_scalar);
  run_all_L1(workspace, workspace.nocc_a(), workspace.nocc_b(), workspace.nvir_a(), workspace.nvir_b(), workspace.nmo(), workspace.nao_a(), workspace.nao_b(), workspace.nav_a(), workspace.nav_b(), workspace.nact());
}

void evaluate_L2_OO(DuccGeneratedWorkspace &workspace, std::size_t nocc_a, std::size_t nocc_b, std::size_t nvirt_a, std::size_t nvirt_b, std::size_t nmo, std::size_t nao_a, std::size_t nao_b, std::size_t nav_a, std::size_t nav_b, std::size_t nact) {

  btas::Tensor<double> Fbar_OO = workspace.get("Fbar", "OO", "AA");
  btas::Tensor<double> I_ovOV(nocc_a, nvirt_a, nao_b, nvirt_b);
  I_ovOV.fill(0.0);
  btas::Tensor<double> I_vv(nvirt_a, nvirt_a);
  I_vv.fill(0.0);
  btas::Tensor<double> t__ov(nocc_a, nvirt_a);
  t__ov.fill(0.0);
  btas::Tensor<double> t_vo = workspace.get("t", "vo", "--");
  qdk_btas::accumulate(1.0, t_vo, {'a', 'i'}, t__ov, {'i', 'a'});
  t_vo.clear();
  btas::Tensor<double> f_vo = workspace.get("f", "vo", "--");
  btas::contract(1.0, t__ov, {'i', 'a'}, f_vo, {'j', 'i'}, 1.0, I_vv, {'j', 'a'});
  f_vo.clear();
  t__ov.clear();
  btas::Tensor<double> t_vVoO = workspace.get("t", "vVoO", "---A");
  btas::contract(1.0, I_vv, {'a', 'i'}, t_vVoO, {'i', 'j', 'k', 'l'}, 1.0, I_ovOV, {'k', 'a', 'l', 'j'});
  t_vVoO.clear();
  I_vv.clear();
  btas::Tensor<double> t__oOvV(nocc_a, nao_b, nvirt_a, nvirt_b);
  t__oOvV.fill(0.0);
  t_vVoO = workspace.get("t", "vVoO", "---A");
  qdk_btas::accumulate(1.0, t_vVoO, {'a', 'i', 'j', 'k'}, t__oOvV, {'j', 'k', 'a', 'i'});
  t_vVoO.clear();
  btas::contract(-0.66666666666666663, I_ovOV, {'i', 'a', 'j', 'k'}, t__oOvV, {'i', 'l', 'a', 'k'}, 1.0, Fbar_OO, {'l', 'j'});
  t__oOvV.clear();
  I_ovOV.clear();
