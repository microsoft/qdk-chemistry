  t_vvoo.clear();
  btas::Tensor<double> f_vo = provider.get("f", "vo", "--");
  btas::contract(1.0, t__oovv, {'i', 'j', 'a', 'k'}, f_vo, {'a', 'i'}, 1.0, I_ov, {'j', 'k'});
  f_vo.clear();
  t__oovv.clear();
  btas::Tensor<double> t_vo = provider.get("t", "vo", "--");
  E0 += 0.5 * qdk_btas::scalar_contract(I_ov, {'i', 'a'}, t_vo, {'a', 'i'});
  t_vo.clear();
  I_ov.clear();
  provider.put_scalar("E0", E0);

  E0 = provider.get_scalar("E0");
  btas::Tensor<double> t__ov(nocc, nvirt);
  t__ov.fill(0.0);
  t_vo = provider.get("t", "vo", "--");
  qdk_btas::accumulate(1.0, t_vo, {'a', 'i'}, t__ov, {'i', 'a'});
