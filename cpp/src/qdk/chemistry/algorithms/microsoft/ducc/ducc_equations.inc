// Internal workspace used only by generated equations. The caller supplies
// full QDK-layout tensors once; generated code owns all Fock construction,
// block gathering, amplitude adaptation, BCH evaluation, and final conversion.
class DuccGeneratedWorkspace {
  using TensorKey = std::tuple<std::string, std::string, std::string>;
  using IndexLists = std::vector<std::vector<std::size_t>>;
  using ActiveFlags = std::vector<std::vector<bool>>;

 public:
  DuccGeneratedWorkspace(
      const btas::Tensor<double>& h_a, const btas::Tensor<double>& h_b,
      const btas::Tensor<double>& v_aa, const btas::Tensor<double>& v_ab,
      const btas::Tensor<double>& v_bb, const btas::Tensor<double>& t1_a,
      const btas::Tensor<double>& t1_b, const btas::Tensor<double>& t2_ab,
      const btas::Tensor<double>& t2_aa, const btas::Tensor<double>& t2_bb,
      std::span<const std::uint32_t> active_a,
      std::span<const std::uint32_t> active_b, std::size_t nocc_a,
      std::size_t nocc_b, bool restricted,
      double core_energy, btas::Tensor<double>& output_one_a,
      btas::Tensor<double>& output_one_b,
      btas::Tensor<double>& output_two_aa,
      btas::Tensor<double>& output_two_ab,
      btas::Tensor<double>& output_two_bb, double& output_scalar)
      : _h_a(h_a),
        _h_b(h_b),
        _v_aa(v_aa),
        _v_ab(v_ab),
        _v_bb(v_bb),
        _t1_a(t1_a),
        _t1_b(t1_b),
        _t2_ab(t2_ab),
        _t2_aa(t2_aa),
        _t2_bb(t2_bb),
        _active_a(active_a),
        _active_b(active_b),
        _output_one_a(output_one_a),
        _output_one_b(output_one_b),
        _output_two_aa(output_two_aa),
        _output_two_ab(output_two_ab),
        _output_two_bb(output_two_bb),
        _output_scalar(output_scalar),
        _restricted(restricted),
        _core_energy(core_energy),
        _nmo(h_a.extent(0)),
        _nocc_a(nocc_a),
        _nocc_b(nocc_b),
        _nvir_a(_nmo - _nocc_a),
        _nvir_b(_nmo - _nocc_b),
        _nao_a(count_active_occupied(active_a, _nocc_a)),
        _nao_b(count_active_occupied(active_b, _nocc_b)),
        _nav_a(active_a.size() - _nao_a),
        _nav_b(active_b.size() - _nao_b),
        _nact(active_a.size()) {
    if (active_b.size() != _nact)
      throw std::runtime_error(
          "ducc: alpha and beta P-spaces must have equal size");
  }

  btas::Tensor<double> get(const std::string& label, const std::string& tags,
                           const std::string& mask) {
    const TensorKey key{label, tags, mask};
    if (auto it = _store.find(key); it != _store.end()) return it->second;
    auto tensor = make(label, tags, mask);
    _store.emplace(key, tensor);
    return tensor;
  }

  void put(const std::string& label, const std::string& tags,
           const std::string& mask, const btas::Tensor<double>& value) {
    _store[TensorKey{label, tags, mask}] = value;
  }

  double get_scalar(const std::string&) const { return _bch_scalar; }
  void put_scalar(const std::string&, double value) { _bch_scalar = value; }

  std::size_t nmo() const { return _nmo; }
  std::size_t nocc_a() const { return _nocc_a; }
  std::size_t nocc_b() const { return _nocc_b; }
  std::size_t nvir_a() const { return _nvir_a; }
  std::size_t nvir_b() const { return _nvir_b; }
  std::size_t nact() const { return _nact; }
  std::size_t nao_a() const { return _nao_a; }
  std::size_t nao_b() const { return _nao_b; }
  std::size_t nav_a() const { return _nav_a; }
  std::size_t nav_b() const { return _nav_b; }

  btas::Tensor<double> raw_one_body(bool beta) const {
    return beta ? _h_b : _h_a;
  }

  btas::Tensor<double> raw_two_body(int channel) const {
    if (channel == 0) return _v_aa;
    if (channel == 1) return _v_ab;
    if (channel == 2) return _v_bb;
    throw std::invalid_argument("ducc: invalid two-body spin channel");
  }

  btas::Tensor<double> occupied_projector(bool beta) const {
    btas::Tensor<double> result{btas::Range{_nmo, _nmo}};
    result.fill(0.0);
    const std::size_t nocc = beta ? _nocc_b : _nocc_a;
    for (std::size_t i = 0; i < nocc; ++i) result(i, i) = 1.0;
    return result;
  }

  btas::Tensor<double> active_occupied_projector(bool beta) const {
    btas::Tensor<double> result{btas::Range{_nact, _nact}};
    result.fill(0.0);
    const std::size_t nocc = beta ? _nocc_b : _nocc_a;
    const auto active = active_indices(beta);
    for (std::size_t i = 0; i < active.size(); ++i)
      if (active[i] < nocc) result(i, i) = 1.0;
    return result;
  }

  double core_energy() const { return _core_energy; }
  double reference_energy() const { return _reference_energy; }
  void set_reference_energy(double value) { _reference_energy = value; }

  void set_fock(btas::Tensor<double> alpha, btas::Tensor<double> beta) {
    _fock_a = std::move(alpha);
    _fock_b = std::move(beta);
  }

  btas::Tensor<double> assemble_one_body(bool beta) const {
    btas::Tensor<double> result{btas::Range{_nact, _nact}};
    result.fill(0.0);
    for (const auto& [key, block] : _store) {
      const auto& label = std::get<0>(key);
      const auto& tags = std::get<1>(key);
      if (label != "Fbar" || is_beta(tags.front()) != beta) continue;
      for (std::size_t i = 0; i < block.extent(0); ++i)
        for (std::size_t j = 0; j < block.extent(1); ++j)
          result(output_index(tags[0], i), output_index(tags[1], j)) +=
              block(i, j);
    }
    return result;
  }

  btas::Tensor<double> assemble_two_body(int channel) const {
    if (channel < 0 || channel > 2)
      throw std::invalid_argument("ducc: invalid two-body spin channel");

    btas::Tensor<double> result{btas::Range{_nact, _nact, _nact, _nact}};
    result.fill(0.0);
    for (const auto& [key, block] : _store) {
      const auto& label = std::get<0>(key);
      const auto& tags = std::get<1>(key);
      if (label != "Vbar") continue;
      const auto alpha_count = static_cast<std::size_t>(std::count_if(
          tags.begin(), tags.end(), [](char tag) { return !is_beta(tag); }));
      if ((channel == 0 && alpha_count != 4) ||
          (channel == 1 && alpha_count != 2) ||
          (channel == 2 && alpha_count != 0))
        continue;

      for (std::size_t i = 0; i < block.extent(0); ++i)
        for (std::size_t j = 0; j < block.extent(1); ++j)
          for (std::size_t k = 0; k < block.extent(2); ++k)
            for (std::size_t l = 0; l < block.extent(3); ++l) {
              std::size_t p = output_index(tags[0], i);
              std::size_t q = output_index(tags[1], j);
              std::size_t r = output_index(tags[2], k);
              std::size_t s = output_index(tags[3], l);
              if (channel == 1 && is_beta(tags[0])) {
                std::swap(p, q);
                std::swap(r, s);
              }
              result(p, q, r, s) += block(i, j, k, l);
            }
    }
    return result;
  }

  void put_final(btas::Tensor<double> one_a, btas::Tensor<double> one_b,
                 btas::Tensor<double> two_aa, btas::Tensor<double> two_ab,
                 btas::Tensor<double> two_bb, double scalar) {
    _output_one_a = std::move(one_a);
    _output_one_b = std::move(one_b);
    _output_two_aa = std::move(two_aa);
    _output_two_ab = std::move(two_ab);
    _output_two_bb = std::move(two_bb);
    _output_scalar = scalar;
  }

 private:
  static std::size_t count_active_occupied(
      std::span<const std::uint32_t> active, std::size_t nocc) {
    return static_cast<std::size_t>(std::count_if(
        active.begin(), active.end(),
        [nocc](std::uint32_t orbital) { return orbital < nocc; }));
  }

  static bool is_beta(char space) {
    return space == 'O' || space == 'V' || space == 'P';
  }

  static std::size_t index4(std::size_t n, std::size_t p, std::size_t q,
                            std::size_t r, std::size_t s) {
    return ((p * n + q) * n + r) * n + s;
  }

  std::span<const std::uint32_t> active_indices(bool beta) const {
    return beta ? _active_b : _active_a;
  }

  std::size_t full_extent(char space) const {
    if (space == 'o') return _nocc_a;
    if (space == 'O') return _nocc_b;
    if (space == 'v') return _nvir_a;
    if (space == 'V') return _nvir_b;
    return _nmo;
  }

  std::vector<std::size_t> selected_indices(char space) const {
    const bool beta = is_beta(space);
    const std::size_t nocc = beta ? _nocc_b : _nocc_a;
    std::vector<std::size_t> indices;
    for (std::uint32_t orbital : active_indices(beta)) {
      if (space == 'p' || space == 'P')
        indices.push_back(orbital);
      else if (space == 'o' || space == 'O') {
        if (orbital < nocc) indices.push_back(orbital);
      } else if (orbital >= nocc) {
        indices.push_back(orbital - nocc);
      }
    }
    return indices;
  }

  std::size_t output_index(char space, std::size_t local) const {
    if (space == 'v') return _nao_a + local;
    if (space == 'V') return _nao_b + local;
    return local;
  }

  std::size_t spatial_index(char space, std::size_t local) const {
    if (space == 'v') return _nocc_a + local;
    if (space == 'V') return _nocc_b + local;
    return local;
  }

  bool is_active(char space, std::size_t local) const {
    const bool beta = is_beta(space);
    const auto active = active_indices(beta);
    const auto spatial = spatial_index(space, local);
    return std::binary_search(active.begin(), active.end(), spatial);
  }

  void gather_fock(const std::string& tags, const IndexLists& source,
                   btas::Tensor<double>& result) const {
    const bool beta = is_beta(tags[0]);
    if (beta != is_beta(tags[1])) return;
    const auto& fock = beta ? _fock_b : _fock_a;
    for (std::size_t p = 0; p < source[0].size(); ++p)
      for (std::size_t q = 0; q < source[1].size(); ++q)
        result(p, q) = fock(spatial_index(tags[0], source[0][p]),
                            spatial_index(tags[1], source[1][q]));
  }

  void gather_two_body(const std::string& tags, const IndexLists& source,
                       btas::Tensor<double>& result) const {
    const bool first_beta = is_beta(tags[0]);
    const bool second_beta = is_beta(tags[2]);
    const btas::Tensor<double>* block;
    bool swap_particles = false;
    if (first_beta == second_beta) {
      block = first_beta ? &_v_bb : &_v_aa;
    } else {
      block = &_v_ab;
      swap_particles = first_beta;
    }

    for (std::size_t i = 0; i < source[0].size(); ++i)
      for (std::size_t j = 0; j < source[1].size(); ++j)
        for (std::size_t k = 0; k < source[2].size(); ++k)
          for (std::size_t l = 0; l < source[3].size(); ++l) {
            const auto p = spatial_index(tags[0], source[0][i]);
            const auto q = spatial_index(tags[1], source[1][j]);
            const auto r = spatial_index(tags[2], source[2][k]);
            const auto s = spatial_index(tags[3], source[3][l]);
            const auto flat = swap_particles ? index4(_nmo, r, s, p, q)
                                             : index4(_nmo, p, q, r, s);
            result(i, j, k, l) = block->data()[flat];
          }
  }

  ActiveFlags active_flags(const std::string& tags,
                           const IndexLists& source) const {
    ActiveFlags result(tags.size());
    for (std::size_t axis = 0; axis < tags.size(); ++axis) {
      result[axis].reserve(source[axis].size());
      for (std::size_t local : source[axis])
        result[axis].push_back(is_active(tags[axis], local));
    }
    return result;
  }

  template <typename Value>
  void gather_rank4_amplitude(const IndexLists& source,
                              const ActiveFlags& active, bool virtual_first,
                              btas::Tensor<double>& result,
                              Value&& value) const {
    for (std::size_t w = 0; w < source[0].size(); ++w)
      for (std::size_t x = 0; x < source[1].size(); ++x)
        for (std::size_t y = 0; y < source[2].size(); ++y)
          for (std::size_t z = 0; z < source[3].size(); ++z) {
            if (active[0][w] && active[1][x] && active[2][y] && active[3][z])
              continue;
            const std::size_t a = virtual_first ? source[0][w] : source[2][y];
            const std::size_t b = virtual_first ? source[1][x] : source[3][z];
            const std::size_t i = virtual_first ? source[2][y] : source[0][w];
            const std::size_t j = virtual_first ? source[3][z] : source[1][x];
            result(w, x, y, z) = value(i, j, a, b);
          }
  }

  double mixed_t2(std::size_t i, std::size_t j, std::size_t a,
                  std::size_t b) const {
    return _t2_ab.data()[
      ((i * _nocc_b + j) * _nvir_a + a) * _nvir_b + b];
  }

  void gather_amplitude(const std::string& tags, const IndexLists& source,
                        btas::Tensor<double>& result) const {
    const auto active = active_flags(tags, source);
    const bool virtual_first = tags[0] == 'v' || tags[0] == 'V';
    if (tags.size() == 2) {
      const char virtual_space = tags[virtual_first ? 0 : 1];
      const char occupied_space = tags[virtual_first ? 1 : 0];
      if (is_beta(virtual_space) != is_beta(occupied_space)) return;
      const auto& t1 = is_beta(virtual_space) ? _t1_b : _t1_a;
      const std::size_t nvir = is_beta(virtual_space) ? _nvir_b : _nvir_a;
      for (std::size_t x = 0; x < source[0].size(); ++x)
        for (std::size_t y = 0; y < source[1].size(); ++y) {
          if (active[0][x] && active[1][y]) continue;
          const std::size_t a = virtual_first ? source[0][x] : source[1][y];
          const std::size_t i = virtual_first ? source[1][y] : source[0][x];
          result(x, y) = t1.data()[i * nvir + a];
        }
      return;
    }

    const char va = tags[virtual_first ? 0 : 2];
    const char vb = tags[virtual_first ? 1 : 3];
    const char oi = tags[virtual_first ? 2 : 0];
    const char oj = tags[virtual_first ? 3 : 1];
    if (is_beta(va) != is_beta(oi) || is_beta(vb) != is_beta(oj)) return;

    if (is_beta(va) != is_beta(vb)) {
      if (is_beta(va)) {
        gather_rank4_amplitude(
            source, active, virtual_first, result,
            [this](std::size_t i, std::size_t j, std::size_t a, std::size_t b) {
              return mixed_t2(j, i, b, a);
            });
      } else {
        gather_rank4_amplitude(
            source, active, virtual_first, result,
            [this](std::size_t i, std::size_t j, std::size_t a, std::size_t b) {
              return mixed_t2(i, j, a, b);
            });
      }
      return;
    }

    if (_restricted) {
      gather_rank4_amplitude(
          source, active, virtual_first, result,
          [this](std::size_t i, std::size_t j, std::size_t a, std::size_t b) {
            return mixed_t2(i, j, a, b) - mixed_t2(i, j, b, a);
          });
      return;
    }

    const auto& t2 = is_beta(va) ? _t2_bb : _t2_aa;
    const std::size_t nocc = is_beta(va) ? _nocc_b : _nocc_a;
    const std::size_t nvir = is_beta(va) ? _nvir_b : _nvir_a;
    gather_rank4_amplitude(
        source, active, virtual_first, result,
        [&t2, nocc, nvir](std::size_t i, std::size_t j, std::size_t a,
                          std::size_t b) {
          return t2.data()[((i * nocc + j) * nvir + a) * nvir + b];
        });
  }

  btas::Tensor<double> make(const std::string& label, const std::string& tags,
                            const std::string& mask) const {
    IndexLists source(tags.size());
    std::vector<std::size_t> extents(tags.size());
    for (std::size_t i = 0; i < tags.size(); ++i) {
      if (i < mask.size() && mask[i] == 'A') {
        source[i] = selected_indices(tags[i]);
      } else {
        source[i].resize(full_extent(tags[i]));
        std::iota(source[i].begin(), source[i].end(), std::size_t{0});
      }
      extents[i] = source[i].size();
    }

    btas::Tensor<double> result{btas::Range{extents}};
    result.fill(0.0);
    if (label == "Fbar" || label == "Vbar") return result;
    if (label == "f")
      gather_fock(tags, source, result);
    else if (label == "v")
      gather_two_body(tags, source, result);
    else if (label == "t" || label == "t_")
      gather_amplitude(tags, source, result);
    else
      throw std::runtime_error("ducc: unsupported tensor '" + label + "'");
    return result;
  }

  const btas::Tensor<double>& _h_a;
  const btas::Tensor<double>& _h_b;
  const btas::Tensor<double>& _v_aa;
  const btas::Tensor<double>& _v_ab;
  const btas::Tensor<double>& _v_bb;
  const btas::Tensor<double>& _t1_a;
  const btas::Tensor<double>& _t1_b;
  const btas::Tensor<double>& _t2_ab;
  const btas::Tensor<double>& _t2_aa;
  const btas::Tensor<double>& _t2_bb;
  std::span<const std::uint32_t> _active_a;
  std::span<const std::uint32_t> _active_b;
  btas::Tensor<double>& _output_one_a;
  btas::Tensor<double>& _output_one_b;
  btas::Tensor<double>& _output_two_aa;
  btas::Tensor<double>& _output_two_ab;
  btas::Tensor<double>& _output_two_bb;
  double& _output_scalar;
  bool _restricted;
  double _core_energy;
  std::size_t _nmo;
  std::size_t _nocc_a;
  std::size_t _nocc_b;
  std::size_t _nvir_a;
  std::size_t _nvir_b;
  std::size_t _nao_a;
  std::size_t _nao_b;
  std::size_t _nav_a;
  std::size_t _nav_b;
  std::size_t _nact;
  btas::Tensor<double> _fock_a;
  btas::Tensor<double> _fock_b;
  double _reference_energy = 0.0;
  std::map<TensorKey, btas::Tensor<double>> _store;
  double _bch_scalar = 0.0;
};

// Generated BTAS contraction code. Do not edit.
#include <btas/btas.h>
#include <btas/tensor.h>

#include <cmath>
#include <vector>

namespace qdk_btas {

// Annotations are emitted as braced character lists. A braced-init-list cannot
// deduce a template parameter, so -- exactly as btas::contract does -- the
// annotation parameters are concrete std::initializer_list.
//
// These are ADAPTERS ONLY: every arithmetic operation below is a BTAS call.
// btas::contract is binary and writes a tensor, so the two shapes it cannot
// express are implemented with the BTAS primitives permute, scal, and dot.
using Ann = std::initializer_list<char>;

inline std::vector<char> ann(Ann a) {
  return std::vector<char>(a.begin(), a.end());
}

/// R(aR) += alpha * A(aA)
///
/// A single-operand term is a permuted accumulation -- e.g. materialising
/// T-dagger for sigma = T - T-dagger -- so there is no second operand for
/// btas::contract.
template <class TensorT>
void accumulate(double alpha, const TensorT &A, Ann aA, TensorT &R, Ann aR) {
  TensorT tmp;
  btas::permute(A, ann(aA), tmp, ann(aR));
  btas::scal(alpha, tmp);
  R += tmp;
}

/// Full contraction of two tensors to a scalar.
///
/// btas::contract cannot produce a rank-0 result, so B is aligned to A's index
/// order and the reduction is done with btas::dot.
template <class TensorT>
double scalar_contract(const TensorT &A, Ann aA, const TensorT &B, Ann aB) {
  TensorT Bp;
  btas::permute(B, ann(aB), Bp, ann(aA));
  return btas::dot(A, Bp);
}

}  // namespace qdk_btas

void evaluate_L0_PP(DuccGeneratedWorkspace &workspace, std::size_t nocc_a, std::size_t nocc_b, std::size_t nvirt_a, std::size_t nvirt_b, std::size_t nmo, std::size_t nao_a, std::size_t nao_b, std::size_t nav_a, std::size_t nav_b, std::size_t nact) {

  btas::Tensor<double> Fbar_PP = workspace.get("Fbar", "PP", "AA");
  btas::Tensor<double> f_PP = workspace.get("f", "PP", "AA");
  qdk_btas::accumulate(1.0, f_PP, {'p', 'i'}, Fbar_PP, {'p', 'i'});
  f_PP.clear();
  workspace.put("Fbar", "PP", "AA", Fbar_PP);
}

void evaluate_L0_PPPP(DuccGeneratedWorkspace &workspace, std::size_t nocc_a, std::size_t nocc_b, std::size_t nvirt_a, std::size_t nvirt_b, std::size_t nmo, std::size_t nao_a, std::size_t nao_b, std::size_t nav_a, std::size_t nav_b, std::size_t nact) {

  btas::Tensor<double> Vbar_PPPP = workspace.get("Vbar", "PPPP", "AAAA");
  btas::Tensor<double> v_PPPP = workspace.get("v", "PPPP", "AAAA");
  qdk_btas::accumulate(0.25, v_PPPP, {'p', 'i', 'j', 'k'}, Vbar_PPPP, {'p', 'j', 'i', 'k'});
  v_PPPP.clear();
  v_PPPP = workspace.get("v", "PPPP", "AAAA");
  qdk_btas::accumulate(-0.25, v_PPPP, {'p', 'i', 'j', 'k'}, Vbar_PPPP, {'p', 'j', 'k', 'i'});
  v_PPPP.clear();
  workspace.put("Vbar", "PPPP", "AAAA", Vbar_PPPP);
}

void evaluate_L0_pPpP(DuccGeneratedWorkspace &workspace, std::size_t nocc_a, std::size_t nocc_b, std::size_t nvirt_a, std::size_t nvirt_b, std::size_t nmo, std::size_t nao_a, std::size_t nao_b, std::size_t nav_a, std::size_t nav_b, std::size_t nact) {

  btas::Tensor<double> Vbar_pPpP = workspace.get("Vbar", "pPpP", "AAAA");
  btas::Tensor<double> v_ppPP = workspace.get("v", "ppPP", "AAAA");
