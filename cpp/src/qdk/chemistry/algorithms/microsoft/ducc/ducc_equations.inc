  btas::contract(1.0, two_ab, {'m', 'n', 'p', 'q'}, occupied_a, {'m', 'p'}, 0.0, occupied_pair, {'n', 'q'});
  chi0 -= btas::dot(occupied_pair, occupied_b);
  provider.put_final(std::move(chi_a), std::move(chi_b), to_chemist_L2(two_aa, 0.5), to_chemist_L2(two_ab, 1.0), to_chemist_L2(two_bb, 0.5), chi0);
}
