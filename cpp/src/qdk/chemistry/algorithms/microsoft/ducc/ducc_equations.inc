void evaluate_L1_OOOO(DuccGeneratedWorkspace &workspace, std::size_t nocc_a, std::size_t nocc_b, std::size_t nvirt_a, std::size_t nvirt_b, std::size_t nmo, std::size_t nao_a, std::size_t nao_b, std::size_t nav_a, std::size_t nav_b, std::size_t nact) {

