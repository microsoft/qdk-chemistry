void evaluate_L1_scalar(TensorProvider &provider, std::size_t nocc, std::size_t nvirt, std::size_t nmo, std::size_t nao, std::size_t nav, std::size_t nact) {

  double E0 = provider.get_scalar("E0");
  btas::Tensor<double> I_ov(nocc, nvirt);
  I_ov.fill(0.0);
  btas::Tensor<double> t__oovv(nocc, nocc, nvirt, nvirt);
  t__oovv.fill(0.0);
  btas::Tensor<double> t_vvoo = provider.get("t", "vvoo", "----");
