void initialize_inputs_L1(TensorProvider &provider) {
  auto h_a = provider.raw_one_body(false);
  auto h_b = provider.raw_one_body(true);
  auto v_aa = provider.raw_two_body(0);
  auto v_ab = provider.raw_two_body(1);
  auto v_bb = provider.raw_two_body(2);
  auto d_a = provider.occupied_projector(false);
  auto d_b = provider.occupied_projector(true);
  auto f_a = h_a;
  auto f_b = h_b;
  btas::contract(1.0, v_aa, {'p', 'q', 'm', 'n'}, d_a, {'m', 'n'}, 1.0, f_a, {'p', 'q'});
  btas::contract(-1.0, v_aa, {'p', 'm', 'n', 'q'}, d_a, {'m', 'n'}, 1.0, f_a, {'p', 'q'});
  btas::contract(1.0, v_ab, {'p', 'q', 'm', 'n'}, d_b, {'m', 'n'}, 1.0, f_a, {'p', 'q'});
  btas::contract(1.0, v_bb, {'p', 'q', 'm', 'n'}, d_b, {'m', 'n'}, 1.0, f_b, {'p', 'q'});
  btas::contract(-1.0, v_bb, {'p', 'm', 'n', 'q'}, d_b, {'m', 'n'}, 1.0, f_b, {'p', 'q'});
  btas::contract(1.0, v_ab, {'m', 'n', 'p', 'q'}, d_a, {'m', 'n'}, 1.0, f_b, {'p', 'q'});
  const double reference = provider.core_energy() + 0.5 * (btas::dot(h_a, d_a) + btas::dot(f_a, d_a) + btas::dot(h_b, d_b) + btas::dot(f_b, d_b));
  provider.set_fock(std::move(f_a), std::move(f_b));
  provider.set_reference_energy(reference);
}

btas::Tensor<double> antisymmetrize_L1(const btas::Tensor<double> &input) {
  btas::Tensor<double> output{input.range()};
  output.fill(0.0);
  qdk_btas::accumulate(1.0, input, {'p', 'q', 'r', 's'}, output, {'p', 'q', 'r', 's'});
  qdk_btas::accumulate(-1.0, input, {'q', 'p', 'r', 's'}, output, {'p', 'q', 'r', 's'});
  qdk_btas::accumulate(-1.0, input, {'p', 'q', 's', 'r'}, output, {'p', 'q', 'r', 's'});
  qdk_btas::accumulate(1.0, input, {'q', 'p', 's', 'r'}, output, {'p', 'q', 'r', 's'});
  return output;
}

btas::Tensor<double> to_chemist_L1(const btas::Tensor<double> &input, double factor) {
  btas::Tensor<double> output{input.range()};
  output.fill(0.0);
  qdk_btas::accumulate(factor, input, {'p', 'q', 'r', 's'}, output, {'p', 'r', 'q', 's'});
  return output;
}

