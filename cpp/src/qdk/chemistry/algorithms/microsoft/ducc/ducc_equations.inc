void initialize_inputs_L0(DuccGeneratedWorkspace &workspace) {
  auto h_a = workspace.raw_one_body(false);
  auto h_b = workspace.raw_one_body(true);
  auto v_aa = workspace.raw_two_body(0);
  auto v_ab = workspace.raw_two_body(1);
  auto v_bb = workspace.raw_two_body(2);
  auto d_a = workspace.occupied_projector(false);
  auto d_b = workspace.occupied_projector(true);
  auto f_a = h_a;
  auto f_b = h_b;
  btas::contract(1.0, v_aa, {'p', 'q', 'm', 'n'}, d_a, {'m', 'n'}, 1.0, f_a, {'p', 'q'});
  btas::contract(-1.0, v_aa, {'p', 'm', 'n', 'q'}, d_a, {'m', 'n'}, 1.0, f_a, {'p', 'q'});
  btas::contract(1.0, v_ab, {'p', 'q', 'm', 'n'}, d_b, {'m', 'n'}, 1.0, f_a, {'p', 'q'});
  btas::contract(1.0, v_bb, {'p', 'q', 'm', 'n'}, d_b, {'m', 'n'}, 1.0, f_b, {'p', 'q'});
  btas::contract(-1.0, v_bb, {'p', 'm', 'n', 'q'}, d_b, {'m', 'n'}, 1.0, f_b, {'p', 'q'});
  btas::contract(1.0, v_ab, {'m', 'n', 'p', 'q'}, d_a, {'m', 'n'}, 1.0, f_b, {'p', 'q'});
  const double reference = workspace.core_energy() + 0.5 * (btas::dot(h_a, d_a) + btas::dot(f_a, d_a) + btas::dot(h_b, d_b) + btas::dot(f_b, d_b));
  workspace.set_fock(std::move(f_a), std::move(f_b));
  workspace.set_reference_energy(reference);
}

btas::Tensor<double> antisymmetrize_L0(const btas::Tensor<double> &input) {
  btas::Tensor<double> output{input.range()};
  output.fill(0.0);
  qdk_btas::accumulate(1.0, input, {'p', 'q', 'r', 's'}, output, {'p', 'q', 'r', 's'});
  qdk_btas::accumulate(-1.0, input, {'q', 'p', 'r', 's'}, output, {'p', 'q', 'r', 's'});
  qdk_btas::accumulate(-1.0, input, {'p', 'q', 's', 'r'}, output, {'p', 'q', 'r', 's'});
  qdk_btas::accumulate(1.0, input, {'q', 'p', 's', 'r'}, output, {'p', 'q', 'r', 's'});
  return output;
}

btas::Tensor<double> to_chemist_L0(const btas::Tensor<double> &input, double factor) {
  btas::Tensor<double> output{input.range()};
  output.fill(0.0);
  qdk_btas::accumulate(factor, input, {'p', 'q', 'r', 's'}, output, {'p', 'r', 'q', 's'});
  return output;
}

void run_all_L0(DuccGeneratedWorkspace &workspace, std::size_t nocc_a, std::size_t nocc_b, std::size_t nvirt_a, std::size_t nvirt_b, std::size_t nmo, std::size_t nao_a, std::size_t nao_b, std::size_t nav_a, std::size_t nav_b, std::size_t nact) {
  initialize_inputs_L0(workspace);
  evaluate_L0_PP(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  evaluate_L0_PPPP(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  evaluate_L0_pPpP(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  evaluate_L0_pp(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  evaluate_L0_pppp(workspace, nocc_a, nocc_b, nvirt_a, nvirt_b, nmo, nao_a, nao_b, nav_a, nav_b, nact);
  auto one_a = workspace.assemble_one_body(false);
  auto one_b = workspace.assemble_one_body(true);
  auto two_aa = antisymmetrize_L0(workspace.assemble_two_body(0));
  auto two_ab = workspace.assemble_two_body(1);
  auto two_bb = antisymmetrize_L0(workspace.assemble_two_body(2));
  const double gamma0 = workspace.reference_energy() + workspace.get_scalar("E0");
  auto occupied_a = workspace.active_occupied_projector(false);
  auto occupied_b = workspace.active_occupied_projector(true);
  auto chi_a = one_a;
  auto chi_b = one_b;
  btas::contract(-1.0, two_aa, {'p', 'm', 'q', 'n'}, occupied_a, {'m', 'n'}, 1.0, chi_a, {'p', 'q'});
  btas::contract(-1.0, two_ab, {'p', 'm', 'q', 'n'}, occupied_b, {'m', 'n'}, 1.0, chi_a, {'p', 'q'});
  btas::contract(-1.0, two_bb, {'p', 'm', 'q', 'n'}, occupied_b, {'m', 'n'}, 1.0, chi_b, {'p', 'q'});
  btas::contract(-1.0, two_ab, {'m', 'p', 'n', 'q'}, occupied_a, {'m', 'n'}, 1.0, chi_b, {'p', 'q'});
  double chi0 = gamma0 - btas::dot(chi_a, occupied_a) - btas::dot(chi_b, occupied_b);
  btas::Tensor<double> occupied_pair;
  btas::contract(1.0, two_aa, {'m', 'n', 'p', 'q'}, occupied_a, {'m', 'p'}, 0.0, occupied_pair, {'n', 'q'});
  chi0 -= 0.5 * btas::dot(occupied_pair, occupied_a);
  btas::contract(1.0, two_bb, {'m', 'n', 'p', 'q'}, occupied_b, {'m', 'p'}, 0.0, occupied_pair, {'n', 'q'});
  chi0 -= 0.5 * btas::dot(occupied_pair, occupied_b);
  btas::contract(1.0, two_ab, {'m', 'n', 'p', 'q'}, occupied_a, {'m', 'p'}, 0.0, occupied_pair, {'n', 'q'});
  chi0 -= btas::dot(occupied_pair, occupied_b);
  workspace.put_final(std::move(chi_a), std::move(chi_b), to_chemist_L0(two_aa, 0.5), to_chemist_L0(two_ab, 1.0), to_chemist_L0(two_bb, 0.5), chi0);
}

void evaluate_ducc_L0(
    const btas::Tensor<double> &h_a, const btas::Tensor<double> &h_b,
    const btas::Tensor<double> &v_aa, const btas::Tensor<double> &v_ab,
    const btas::Tensor<double> &v_bb, const btas::Tensor<double> &t1_a,
    const btas::Tensor<double> &t1_b, const btas::Tensor<double> &t2_ab,
    const btas::Tensor<double> &t2_aa, const btas::Tensor<double> &t2_bb,
    std::span<const std::uint32_t> active_a,
    std::span<const std::uint32_t> active_b, std::size_t nocc_a,
    std::size_t nocc_b, bool restricted,
    double core_energy, btas::Tensor<double> &output_one_a,
    btas::Tensor<double> &output_one_b,
    btas::Tensor<double> &output_two_aa,
    btas::Tensor<double> &output_two_ab,
    btas::Tensor<double> &output_two_bb, double &output_scalar) {
  DuccGeneratedWorkspace workspace(
      h_a, h_b, v_aa, v_ab, v_bb, t1_a, t1_b, t2_ab, t2_aa, t2_bb,
      active_a, active_b, nocc_a, nocc_b, restricted,
      core_energy, output_one_a, output_one_b,
      output_two_aa, output_two_ab, output_two_bb, output_scalar);
  run_all_L0(workspace, workspace.nocc_a(), workspace.nocc_b(), workspace.nvir_a(), workspace.nvir_b(), workspace.nmo(), workspace.nao_a(), workspace.nao_b(), workspace.nav_a(), workspace.nav_b(), workspace.nact());
}

