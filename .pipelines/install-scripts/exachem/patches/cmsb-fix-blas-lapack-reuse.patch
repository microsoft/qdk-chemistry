# cmsb-fix-blas-lapack-reuse.patch
# ----------------------------------------------------------------------------------------------------------------------
# Make NWChemEx-Project/CMakeBuild (CMSB, TAMM/ExaChem's superbuild helper) reuse the system BLAS/LAPACK (our own
# OpenBLAS, from install-cpp-deps.sh) instead of always rebuilding its own copy from source, WITHOUT touching the
# global CMSB_DEBUG_CMAKE option (that was tried first and reverted -- see git history/PR discussion: it also
# changes how every *other* TAMM dependency (NJSON, MSGSL, DOCTEST, SPDLOG, ...) is resolved in CMSB's nested
# "TAMM_External" build phase, which broke that phase outright with a hard CMake configure error). This patch is
# instead scoped to exactly the BLAS/LAPACK code paths, leaving everything else byte-for-byte unchanged.
#
# Two independent fixes, both required together:
#
# 1. cmake/macros/DependencyMacros.cmake (cmsb_find_dependency): when CMSB_DEBUG_CMAKE=TRUE (the default, left
#    untouched by this patch), BLAS/LAPACK are DEP_ABUILD items, so they're looked up via
#    find_package(<name> CONFIG NO_DEFAULT_PATH), which apt's libopenblas-dev satisfies for neither (it ships no
#    BLASConfig.cmake/LAPACKConfig.cmake) -- so CMSB always falls through and rebuilds its own static, generic-
#    target OpenBLAS. This function already has a small set of special-cased MODULE-mode find_package() fallbacks
#    for other DEP_ABUILD items whose CONFIG search is known to fail this way (ELPA, HDF5-with-HDF5_ROOT,
#    numactl); add BLAS/LAPACK to that same fallback list. find_package(BLAS/LAPACK QUIET) is CMake's own stock
#    FindBLAS.cmake/FindLAPACK.cmake (MODULE mode), which finds our system OpenBLAS.
#
# 2. cmake/build_external/BuildGlobalArrays.cmake: even with fix #1 making BLAS resolvable, GlobalArrays'
#    LINALG_VENDOR=OpenBLAS/BLIS/IBMESSL branch has its own bug --
#        find_or_build_dependency(LAPACK)
#        if(TARGET BLAS_External)
#            find_or_build_dependency(BLAS)
#        endif()
#    -- find_or_build_dependency(BLAS) only runs if the "BLAS_External" target *already* exists, but the only
#    thing that ever creates that target *is* find_or_build_dependency(BLAS) itself (or, incidentally,
#    BuildLAPACK.cmake calling it internally when LAPACK itself has to be built from source). Once fix #1 makes
#    LAPACK resolve via find_package instead of being built, BuildLAPACK.cmake never runs, so BLAS_External is
#    never created either, and the unconditional add_dependencies(GlobalArrays_External BLAS_External
#    LAPACK_External) a few lines down then fails outright ("target 'BLAS_External' does not exist"). Fix: call
#    find_or_build_dependency(BLAS) unconditionally, mirroring the LAPACK call directly above it.
#
# Applied to a local FetchContent_MakeAvailable(CMakeBuild) source checkout via -DFETCHCONTENT_SOURCE_DIR_CMAKEBUILD
# (see install-exachem.sh) rather than to a vendored copy in this repo, since CMSB isn't a qdk-chemistry dependency
# in its own right -- it's fetched fresh (from NWChemEx-Project/CMakeBuild@main) as part of TAMM/ExaChem's own build.
#
# Apply: git -C <cmsb-src> apply cmsb-fix-blas-lapack-reuse.patch
# ----------------------------------------------------------------------------------------------------------------------
diff --git a/cmake/build_external/BuildGlobalArrays.cmake b/cmake/build_external/BuildGlobalArrays.cmake
index 2221ddc..ae4ea2a 100644
--- a/cmake/build_external/BuildGlobalArrays.cmake
+++ b/cmake/build_external/BuildGlobalArrays.cmake
@@ -90,9 +90,7 @@ include(${CMAKE_CURRENT_LIST_DIR}/dep_versions.cmake)
             list(APPEND  GA_LINALG_ROOT "-DScaLAPACK_PREFIX=${CMAKE_INSTALL_PREFIX}")
         else()
             find_or_build_dependency(LAPACK)
-            if(TARGET BLAS_External)
-                find_or_build_dependency(BLAS)
-            endif()
+            find_or_build_dependency(BLAS)
             #include(BuildBLAS)
         endif()
 
diff --git a/cmake/macros/DependencyMacros.cmake b/cmake/macros/DependencyMacros.cmake
index d70d56d..712dbc8 100644
--- a/cmake/macros/DependencyMacros.cmake
+++ b/cmake/macros/DependencyMacros.cmake
@@ -194,6 +194,8 @@ function(cmsb_find_dependency __name)
                     endif()
                   elseif(${__name} STREQUAL "numactl")
                     find_package(numactl)
+                  elseif(${__name} STREQUAL "BLAS" OR ${__name} STREQUAL "LAPACK")
+                    find_package(${__name} QUIET)
                   endif()
                 endif()
             else()
