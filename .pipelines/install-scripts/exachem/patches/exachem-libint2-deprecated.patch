# exachem-libint2-deprecated.patch
# ----------------------------------------------------------------------------------------------------------------------
# Make ExaChem compile against LibInt2 2.9.0 (the version qdk-chemistry pins). A TAMM-transitive header defines
# its own function-like `DEPRECATED(msg)` macro, which shadows libint2/basis.h's object-like `DEPRECATED` use --
# leaving it as a bare identifier and breaking compilation for any TU that includes tamm.hpp before
# libint2_includes.hpp.
#
# Fix: push_macro/#undef/#define DEPRECATED [[deprecated]] around ExaChem's libint2 includes, then pop_macro to
# restore the foreign macro. Semantically null: DEPRECATED only decorates overloads ExaChem never calls.
#
# Version note: this is a 2.9.0-only artifact. Upstream libint2 renamed the macro at v2.10.1, avoiding the clash
# entirely -- drop this patch once qdk-chemistry bumps past that version.
#
# Apply: git -C <exachem-src> apply exachem-libint2-deprecated.patch
# ----------------------------------------------------------------------------------------------------------------------
diff --git a/exachem/common/libint2_includes.hpp b/exachem/common/libint2_includes.hpp
index 9cba70e..7a00593 100644
--- a/exachem/common/libint2_includes.hpp
+++ b/exachem/common/libint2_includes.hpp
@@ -40,9 +40,18 @@
 #endif
 
 // Libint Gaussian integrals library
+// LibInt2 2.9.0: a header pulled in via tamm.hpp defines DEPRECATED as a
+// function-like macro, so basis.h's object-like use is left unexpanded. Force
+// LibInt2's intended object-like form for the libint2 includes, then restore
+// the dependency's macro via pop_macro below (mirrors the ROCm workaround above).
+#pragma push_macro("DEPRECATED")
+#undef DEPRECATED
+#define DEPRECATED [[deprecated]]
 #include <libint2.hpp>
 #include <libint2/basis.h>
 #include <libint2/chemistry/sto3g_atomic_density.h>
+// Restore the dependency-provided DEPRECATED macro.
+#pragma pop_macro("DEPRECATED")
 
 /* NVCC restore */
 #if defined(__NVCC__REDEFINE__)
