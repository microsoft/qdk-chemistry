# cmsb-fix-blas-guard.patch
# ----------------------------------------------------------------------------------------------------------------------
# Fix a bug in NWChemEx-Project/CMakeBuild (CMSB, TAMM/ExaChem's superbuild helper) that makes BLAS unreachable via
# any find_package()-based reuse path -- forcing it to *always* be rebuilt from source, even with CMSB_DEBUG_CMAKE=OFF
# (see install-exachem.sh) and even when a perfectly good system BLAS (our own OpenBLAS, from install-cpp-deps.sh) is
# already on CMAKE_PREFIX_PATH.
#
# Root cause (cmake/build_external/BuildGlobalArrays.cmake, LINALG_VENDOR=OpenBLAS/BLIS/IBMESSL branch):
#   find_or_build_dependency(LAPACK)
#   if(TARGET BLAS_External)
#       find_or_build_dependency(BLAS)
#   endif()
#
#   find_or_build_dependency(BLAS) is only even *attempted* if the "BLAS_External" CMake target already exists --
#   but the only thing that ever creates that target *is* find_or_build_dependency(BLAS) itself (or, incidentally,
#   BuildLAPACK.cmake calling it internally when LAPACK itself has to be built from source). So whenever LAPACK is
#   *found* (not built) -- which is exactly what we want once CMSB_DEBUG_CMAKE=OFF lets it reuse system LAPACK --
#   BLAS_External never gets created, and the unconditional
#   `add_dependencies(GlobalArrays_External BLAS_External LAPACK_External)` a few lines down then fails outright
#   with "The dependency target 'BLAS_External' of target 'GlobalArrays_External' does not exist." This is what
#   broke our first attempt at -DCMSB_DEBUG_CMAKE=OFF (see install-exachem.sh's COMMON_CMAKE_ARGS comment history).
#
# Fix: call find_or_build_dependency(BLAS) unconditionally, mirroring the LAPACK call directly above it. This makes
# CMSB actually look for (and, with CMSB_DEBUG_CMAKE=OFF, find) our system OpenBLAS via a plain find_package(BLAS
# QUIET), instead of silently skipping BLAS resolution and then crashing on a target that was never created.
#
# Applied to a local FetchContent_MakeAvailable(CMakeBuild) source checkout via -DFETCHCONTENT_SOURCE_DIR_CMAKEBUILD
# (see install-exachem.sh) rather than to a vendored copy in this repo, since CMSB isn't a qdk-chemistry dependency
# in its own right -- it's fetched fresh (from NWChemEx-Project/CMakeBuild@main) as part of TAMM/ExaChem's own build.
#
# Apply: git -C <cmsb-src> apply cmsb-fix-blas-guard.patch
# ----------------------------------------------------------------------------------------------------------------------
diff --git a/cmake/build_external/BuildGlobalArrays.cmake b/cmake/build_external/BuildGlobalArrays.cmake
index 2221ddc..ae4ea2a 100644
--- a/cmake/build_external/BuildGlobalArrays.cmake
+++ b/cmake/build_external/BuildGlobalArrays.cmake
@@ -90,9 +90,7 @@ include(${CMAKE_CURRENT_LIST_DIR}/dep_versions.cmake)
             list(APPEND  GA_LINALG_ROOT "-DScaLAPACK_PREFIX=${CMAKE_INSTALL_PREFIX}")
         else()
             find_or_build_dependency(LAPACK)
-            if(TARGET BLAS_External)
-                find_or_build_dependency(BLAS)
-            endif()
+            find_or_build_dependency(BLAS)
             #include(BuildBLAS)
         endif()
 
