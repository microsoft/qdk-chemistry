# exachem-serial-hdf5.patch
# ----------------------------------------------------------------------------------------------------------------------
# Make ExaChem's SCF I/O compile & link against a *serial* HDF5 when TAMM is built with -DUSE_HDF5=OFF (parallel-HDF5
# layer disabled) and the serial path is selected with -DUSE_SERIAL_IO.
#
# Verified against ExaChem 45c192e / TAMM e485b7a6:
#
#  1) scf_gauxc.cpp uses ExchCXX::libxc_name_string(...). That alias exists ONLY
#     inside `#ifdef EXCHCXX_ENABLE_LIBXC` (exchcxx/enums/backend.hpp). qdk-chemistry's
#     ExchCXX is built WITHOUT libxc, so those calls don't compile.
#     -> Guard each call with #ifdef EXCHCXX_ENABLE_LIBXC / #else throw / #endif.
#  2) scf_outputs.cpp's read/write_scf_mat call get_hdf5_dt<T>() + HDF5 H5* APIs,
#     which tamm/tamm_io.hpp provides ONLY under `#if defined(USE_HDF5)`. With
#     USE_HDF5=OFF they vanish, so we supply a file-local <hdf5.h> include +
#     get_hdf5_dt<T>() under `#if defined(USE_SERIAL_IO)`. Only int/float/double are
#     handled (SCFIO<T> is only ever explicitly instantiated for T=double); an
#     unsupported T fails the build via static_assert instead of silently mapping to
#     the wrong HDF5 type.
#
# Apply: git -C <exachem-src> apply exachem-serial-hdf5.patch
# ----------------------------------------------------------------------------------------------------------------------
diff --git a/exachem/scf/scf_gauxc.cpp b/exachem/scf/scf_gauxc.cpp
index 2eb6896..e25474a 100644
--- a/exachem/scf/scf_gauxc.cpp
+++ b/exachem/scf/scf_gauxc.cpp
@@ -145,8 +145,16 @@ SCFGauxc<T>::setup_gauxc(ExecutionContext& ec, const ChemEnv& chem_env,
           ExchCXX::XCKernel(ExchCXX::Backend::builtin, ExchCXX::kernel_map.value("SCAN_C"), polar));
       }
       else {
+#ifdef EXCHCXX_ENABLE_LIBXC
         kernels.push_back(ExchCXX::XCKernel(ExchCXX::libxc_name_string("MGGA_X_SCAN"), polar));
+#else
+        throw std::runtime_error("ExaChem: this exchange-correlation functional requires ExchCXX built with LibXC support (EXCHCXX_ENABLE_LIBXC).");
+#endif
+#ifdef EXCHCXX_ENABLE_LIBXC
         kernels.push_back(ExchCXX::XCKernel(ExchCXX::libxc_name_string("MGGA_C_SCAN"), polar));
+#else
+        throw std::runtime_error("ExaChem: this exchange-correlation functional requires ExchCXX built with LibXC support (EXCHCXX_ENABLE_LIBXC).");
+#endif
       }
     }
     else if(txt_utils::strequal_case(xcfunc, "R2SCAN")) {
@@ -157,8 +165,16 @@ SCFGauxc<T>::setup_gauxc(ExecutionContext& ec, const ChemEnv& chem_env,
                                             ExchCXX::kernel_map.value("R2SCAN_C"), polar));
       }
       else {
+#ifdef EXCHCXX_ENABLE_LIBXC
         kernels.push_back(ExchCXX::XCKernel(ExchCXX::libxc_name_string("MGGA_X_R2SCAN"), polar));
+#else
+        throw std::runtime_error("ExaChem: this exchange-correlation functional requires ExchCXX built with LibXC support (EXCHCXX_ENABLE_LIBXC).");
+#endif
+#ifdef EXCHCXX_ENABLE_LIBXC
         kernels.push_back(ExchCXX::XCKernel(ExchCXX::libxc_name_string("MGGA_C_R2SCAN"), polar));
+#else
+        throw std::runtime_error("ExaChem: this exchange-correlation functional requires ExchCXX built with LibXC support (EXCHCXX_ENABLE_LIBXC).");
+#endif
       }
       // Try using the builtin backend
     }
@@ -168,7 +184,11 @@ SCFGauxc<T>::setup_gauxc(ExecutionContext& ec, const ChemEnv& chem_env,
       // Fallback to LibXC
     }
     else {
+#ifdef EXCHCXX_ENABLE_LIBXC
       kernels.push_back(ExchCXX::XCKernel(ExchCXX::libxc_name_string(xcfunc), polar));
+#else
+        throw std::runtime_error("ExaChem: this exchange-correlation functional requires ExchCXX built with LibXC support (EXCHCXX_ENABLE_LIBXC).");
+#endif
       if(txt_utils::strequal_case(xcfunc, "HYB_GGA_X_QED") ||
          txt_utils::strequal_case(xcfunc, "HYB_GGA_XC_QED") ||
          txt_utils::strequal_case(xcfunc, "HYB_MGGA_XC_QED") ||
diff --git a/exachem/scf/scf_outputs.cpp b/exachem/scf/scf_outputs.cpp
index ec5faa8..2dd7954 100644
--- a/exachem/scf/scf_outputs.cpp
+++ b/exachem/scf/scf_outputs.cpp
@@ -8,6 +8,19 @@
 
 #include "exachem/scf/scf_outputs.hpp"
 #include "exachem/common/options/parser_utils.hpp"
+#if defined(USE_SERIAL_IO)
+#include <hdf5.h>
+#include <type_traits>
+// Serial-HDF5 build (TAMM USE_HDF5=OFF): tamm::get_hdf5_dt is compiled out,
+// so provide a file-local equivalent for read_scf_mat/write_scf_mat below.
+template<typename T>
+static hid_t get_hdf5_dt() {
+  if constexpr(std::is_same_v<double, T>) return H5T_NATIVE_DOUBLE;
+  else if constexpr(std::is_same_v<float, T>) return H5T_NATIVE_FLOAT;
+  else if constexpr(std::is_same_v<int, T>) return H5T_NATIVE_INT;
+  else static_assert(!sizeof(T), "get_hdf5_dt: unsupported tensor element type");
+}
+#endif
 
 template<typename T>
 double exachem::scf::SCFIO<T>::tt_trace(ExecutionContext& ec, const Tensor<T>& T1,
