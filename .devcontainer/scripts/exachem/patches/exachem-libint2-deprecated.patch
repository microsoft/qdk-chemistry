# exachem-libint2-deprecated.patch
# ----------------------------------------------------------------------------------------------------------------------
# Make ExaChem compile against the LibInt2 2.9.0 shipped in the qdk-chemistry-runtime base image, whose
# <libint2/basis.h> decorates a few BasisSet factory methods with an UNPREFIXED `DEPRECATED` macro (from
# libint2/util/deprecated.h).
#
# Root cause (ExaChem 45c192e + base-image LibInt2 2.9.0):
#   ExaChem TUs that include "tamm/tamm.hpp" BEFORE exachem/common/libint2_includes.hpp
#   (e.g. common/options/parse_options.cpp) pull in a TAMM-transitive header
#   (Global Arrays is the likely source, present only in the build image) that
#   defines its own FUNCTION-LIKE `DEPRECATED(msg)` macro. A function-like macro
#   is not expanded unless followed by "(", so basis.h's `DEPRECATED static
#   size_t nbf(...)` leaves DEPRECATED as a bare identifier ->
#     error: 'DEPRECATED' does not name a type   (basis.h:623/627/631)
#   TUs that reach the header WITHOUT tamm.hpp first (e.g. common/ecatom.cpp)
#   compile fine. This is the same class of clash ExaChem already guards for
#   ROCm in libint2_includes.hpp.
#   -> Wrap ExaChem's three libint2 includes with push_macro / #undef / #define
#      DEPRECATED [[deprecated]] / ...includes... / pop_macro. A naive
#      `#ifndef DEPRECATED` is INSUFFICIENT (the foreign macro *is* defined).
#
# Semantically null: DEPRECATED only decorates deprecated overloads ExaChem never calls; forcing it changes no behaviour
# or ABI.
#
# Version note: this is a 2.9.0-only artifact. Upstream libint2 renamed the macro DEPRECATED -> LIBINT2_DEPRECATED at
# v2.10.1 ("avoid clashing with previous definitions"); >=2.10.1 is immune. CMSB pins 2.11.2. Long-term fix: bump the
# base image's libint2 to 2.11.2, then this patch can be dropped.
#
# Apply: git -C <exachem-src> apply exachem-libint2-deprecated.patch
# ----------------------------------------------------------------------------------------------------------------------
diff --git a/exachem/common/libint2_includes.hpp b/exachem/common/libint2_includes.hpp
index 9cba70e..7a00593 100644
--- a/exachem/common/libint2_includes.hpp
+++ b/exachem/common/libint2_includes.hpp
@@ -40,9 +40,18 @@
 #endif
 
 // Libint Gaussian integrals library
+// qaml: reused base-image LibInt2 (2.9.0): a header pulled in via tamm.hpp defines DEPRECATED as a
+// function-like macro, so basis.h's object-like use is left unexpanded. Force
+// LibInt2's intended object-like form for the libint2 includes, then restore
+// the dependency's macro via pop_macro below (mirrors the ROCm workaround above).
+#pragma push_macro("DEPRECATED")
+#undef DEPRECATED
+#define DEPRECATED [[deprecated]]
 #include <libint2.hpp>
 #include <libint2/basis.h>
 #include <libint2/chemistry/sto3g_atomic_density.h>
+// qaml: reused base-image LibInt2: restore the dependency-provided DEPRECATED macro.
+#pragma pop_macro("DEPRECATED")
 
 /* NVCC restore */
 #if defined(__NVCC__REDEFINE__)
