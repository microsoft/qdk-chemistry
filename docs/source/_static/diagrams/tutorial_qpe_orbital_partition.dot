digraph TutorialQpeOrbitalPartition {
    rankdir=LR;
    nodesep=0.45;
    overlap=false;
    pad=0.2;
    bgcolor="#FAFAFA";

    node [shape=box, style="rounded,filled", fontname="Arial", width=3.1, height=1.2, margin=0.2];

    subgraph cluster_orbitals {
        label="Spatial molecular orbitals";
        style="filled,rounded";
        fillcolor="#E8EAF6";
        color="#5C6BC0";
        penwidth=2.5;
        fontsize=14;
        fontname="Arial Bold";
        fontcolor="#3949AB";
        rank=same;

        Inactive [label=<<B>Inactive orbitals</B><BR/><BR/><FONT POINT-SIZE="11" COLOR="#E3F2FD">Doubly occupied in every determinant</FONT><BR/><FONT POINT-SIZE="11" COLOR="#E3F2FD">Contribute to the core energy</FONT>>, fillcolor="#1976D2", color="#0D47A1", penwidth=2.5, fontcolor="#FFFFFF"];

        Active [label=<<B>Active orbitals</B><BR/><BR/><FONT POINT-SIZE="11" COLOR="#E0F2F1">Occupation varies among determinants</FONT><BR/><FONT POINT-SIZE="11" COLOR="#E0F2F1">Correlation is treated explicitly</FONT>>, fillcolor="#00796B", color="#004D40", penwidth=2.5, fontcolor="#FFFFFF"];

        Virtual [label=<<B>Virtual orbitals</B><BR/><BR/><FONT POINT-SIZE="11" COLOR="#F3E5F5">Empty in every determinant</FONT><BR/><FONT POINT-SIZE="11" COLOR="#F3E5F5">Excluded from the correlated calculation</FONT>>, fillcolor="#7B1FA2", color="#4A148C", penwidth=2.5, fontcolor="#FFFFFF"];

        Inactive -> Active -> Virtual [style=invis, weight=10];
    }
}
